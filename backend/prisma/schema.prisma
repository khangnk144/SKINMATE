// Prisma schema la ban do database cua SKINMATE.
// Flow chinh: User phan tich INCI -> AnalysisHistory luu input,
// Ingredient + IngredientRule quyet dinh GOOD/BAD/NEUTRAL theo skinType,
// Product + ProductIngredient phuc vu recommendation,
// IngredientReport + ReportVote + Notification phuc vu dong gop cong dong.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SkinType {
  // Loai da cua user; dung de chon dung IngredientRule khi phan tich.
  OILY
  DRY
  SENSITIVE
  COMBINATION
  NORMAL
}

enum UserRole {
  USER
  ADMIN
}

enum SafetyEffect {
  // Danh gia do phu hop cua ingredient voi mot SkinType cu the.
  GOOD
  BAD
  NEUTRAL
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VoteType {
  UP
  DOWN
}

model User {
  // Tai khoan nguoi dung va admin. passwordHash la hash bcrypt, khong luu password goc.
  id            String            @id @default(uuid())
  username      String            @unique
  displayName   String?
  passwordHash  String
  skinType      SkinType?         @default(NORMAL)
  role          UserRole          @default(USER)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  histories     AnalysisHistory[]
  ingredientReports IngredientReport[]
  reportVotes   ReportVote[]
  notifications Notification[]
  reviewedAiSuggestions AiIngredientSuggestion[] @relation("AiSuggestionReviewer")
}

model Ingredient {
  // Ingredient.name luu lowercase de match voi INCI input/OCR/import.
  id          Int                 @id @default(autoincrement())
  name        String              @unique // INCI Name in lowercase for matching
  description String?             @db.Text
  rules       IngredientRule[]
  products    ProductIngredient[]
  reports     IngredientReport[]
}

model IngredientRule {
  // Mot ingredient co the GOOD voi loai da nay nhung BAD voi loai da khac.
  id           Int          @id @default(autoincrement())
  ingredientId Int
  skinType     SkinType
  effect       SafetyEffect @default(NEUTRAL)
  
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, skinType]) // One rule per ingredient per skin type
}

model AiIngredientSuggestion {
  // Hang cho ket qua Gemini: chi admin duyet moi day vao Ingredient/IngredientRule chinh thuc.
  id                   Int          @id @default(autoincrement())
  ingredientName       String
  skinType             SkinType
  suggestedEffect      SafetyEffect
  suggestedDescription String?      @db.Text
  status               ReportStatus @default(PENDING)
  source               String       @default("GEMINI")
  occurrenceCount      Int          @default(1)
  pendingKey           String       @unique
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  reviewedAt           DateTime?
  reviewedBy           String?
  adminNote            String?      @db.Text

  reviewer             User?        @relation("AiSuggestionReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([ingredientName])
}

model Product {
  // San pham goi y cho user; ingredient list nam o bang noi ProductIngredient.
  id          String              @id @default(uuid())
  name        String
  brand       String
  imageUrl    String?
  ingredients ProductIngredient[]
  createdAt   DateTime            @default(now())
}

model ProductIngredient {
  // Bang noi many-to-many giua Product va Ingredient, kem position de giu thu tu INCI.
  productId    String
  ingredientId Int
  position     Int // Order of ingredient in the list

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
}

model AnalysisHistory {
  // Luu chuoi INCI user da phan tich de trang History co the chay lai nhanh.
  id        String   @id @default(uuid())
  userId    String
  rawInput  String   @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IngredientReport {
  // Dong gop cua user khi nghi rule hien tai sai; admin resolve de cap nhat IngredientRule.
  id             Int            @id @default(autoincrement())
  ingredientId   Int
  ingredient     Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skinType       SkinType       // The reporter's skin type when reporting (important for rule update)
  reportedEffect SafetyEffect   // The effect the user believes is correct (GOOD/BAD/NEUTRAL)
  reason         String         @db.Text
  evidenceUrl    String?        // Optional link to image or study
  status         ReportStatus   @default(PENDING)
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?        // admin user id
  adminNote      String?        @db.Text
  votes          ReportVote[]
}

model ReportVote {
  // Vote giup admin uu tien report duoc cong dong dong tinh nhieu.
  id           Int        @id @default(autoincrement())
  reportId     Int
  report       IngredientReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  voteType     VoteType
  createdAt    DateTime   @default(now())

  @@unique([reportId, userId])
}

model Notification {
  // Thong bao trong app, vi du khi report cua user duoc duyet/tu choi.
  id        String   @id @default(uuid())
  userId    String   // user who receives the notification
  type      String   // e.g., "REPORT_RESOLVED", "ADMIN_MESSAGE"
  title     String   // short summary
  message   String   @db.Text
  link      String?  // optional URL to navigate when clicked
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
